# Bluey index service configuration (all optional)

# WebSocket + HTTP port
PORT=8787

# SQLite file location (default: packages/server/data/index.db)
# DB_PATH=/var/lib/bluey/index.db

# Comma-separated relay set to ingest the firehose from
RELAYS=wss://relay.damus.io,wss://relay.primal.net,wss://nos.lol,wss://relay.nostr.band,wss://nostr.wine

# Rolling retention window for non-profile events (days)
RETENTION_DAYS=21

# How often to recompute web-of-trust scores (ms)
WOT_INTERVAL_MS=600000

# Domain people claim names on (name@domain = NIP-05 + Lightning address).
# The client's VITE_NAME_DOMAIN must match, and https://<domain>/.well-known/*
# must reach this service (see vercel.json rewrites).
NAME_DOMAIN=bluey.xyz

# Key that signs automatic completion badges (hex). On hosts without a
# persistent disk this MUST be set, or each restart creates a new badge issuer.
# Leave empty locally: one is generated into data/examiner.key.
EXAMINER_SECRET_KEY=
