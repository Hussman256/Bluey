# URL of the Bluey index service (WebSocket). Defaults to ws://localhost:8787.
VITE_INDEX_URL=ws://localhost:8787

# URL of the Bluey clubs relay (NIP-29). Defaults to ws://localhost:8788.
VITE_CLUBS_RELAY=ws://localhost:8788

# npub (or hex pubkey) of the Bluey curator account. It publishes the approved
# tutor list (NIP-51 kind 30000, d=bluey-tutors) and receives tutor
# applications as NIP-17 DMs. Leave empty in development to list every bootcamp.
VITE_BLUEY_CURATOR=

# Domain people claim names on: name@domain is their NIP-05 and Lightning address.
# Must match NAME_DOMAIN on the index service, and its /.well-known/* must reach the index.
VITE_NAME_DOMAIN=bluey.xyz
